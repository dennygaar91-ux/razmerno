# Runtime mode
# true = local mock / localStorage order storage
# false = POST /api/orders or VITE_ORDER_API_URL
VITE_USE_MOCK_API=false

# Optional custom order endpoint. If empty, frontend uses /api/orders.
VITE_ORDER_API_URL=/api/orders

# Yandex Metrica
VITE_YM_ID=
VITE_ANALYTICS_DEBUG=false

# Vercel serverless email route /api/orders
ORDER_MANAGER_EMAIL=
RESEND_API_KEY=
MAIL_FROM=Размерно <mail@razmerno.ru>

# Legal
VITE_PRIVACY_URL=/privacy.html

# Viewer fallback
# 1 = force legacy SVG preview instead of Three.js viewer
VITE_FORCE_SVG_VIEWER=0

# Debug panel
# 1 = allow production model debug panel outside dev mode
VITE_ENABLE_PRODUCTION_DEBUG=0

# Supabase orders database (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API origin whitelist. Comma-separated. Production must include https://razmerno.ru
ALLOWED_ORIGINS=https://razmerno.ru

# Production rate-limit storage for Vercel serverless.
# If empty, API falls back to in-memory rate-limit for local/dev only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
